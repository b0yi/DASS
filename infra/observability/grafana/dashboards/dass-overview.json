    {
      "type": "row",
      "id": 108,
      "title": "Jobs & task runs",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Jobs (definitions)",
      "id": 110,
      "description": "JOB = 工作定義(在 jobs 表)。normal=即時/手動(無 cron);scheduled=有 cron,由排程器管。Normal + Scheduled 相加 = 上方『Jobs in DB』總數。(Scheduled 中『還沒到點、armed』的數量見上方『Scheduler DB jobs (next ≥ now)』。)",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "legendFormat": "Normal (on-demand, no cron)",
          "expr": "sum(dass_jobs_by_enabled_count{job_type=\"normal\"}) or vector(0)"
        },
        {
          "refId": "B",
          "instant": true,
          "legendFormat": "Scheduled (cron)",
          "expr": "sum(dass_jobs_by_enabled_count{job_type=\"scheduled\"}) or vector(0)"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Task runs (executions)",
      "id": 111,
      "description": "TASK run 的『來源』:Trigger-now=在 scheduled job 上按 trigger-now(manual on scheduled);Scheduler-dispatched=排程器自動派發。(成功/失敗/重試看下面 Task outcomes。)",
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 16,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "legendFormat": "Trigger-now (manual on scheduled job)",
          "expr": "sum(dass_tasks_by_job_and_trigger_count{job_type=\"scheduled\",trigger_type=\"manual\"}) or vector(0)"
        },
        {
          "refId": "B",
          "instant": true,
          "legendFormat": "Scheduler-dispatched",
          "expr": "sum(dass_tasks_by_trigger_total{trigger_type=\"scheduled\"}) or vector(0)"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      }
    },
    {
      "type": "row",
      "id": 106,
      "title": "Task throughput (cumulative counters)",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 1
      },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Task outcomes (cumulative)",
      "id": 112,
      "description": "一個失敗 job 的鏈:第1次失敗 → 重試… → 重試用完則放棄(final_failed)。\n• Enqueued = 總共派出幾次執行。• Succeeded = 成功幾次。\n• Failed runs (incl. retries) = 每一次失敗的『執行』,會被中途重試灌水 → 比真正失敗的多。\n• Retries (re-runs) = 其中是『重跑』的次數(retry_count>0)。\n• Final failures (gave up) = 重試用完仍失敗 → 這才是『真正徹底失敗的數量』。\n關係:Failed runs = 第1次就失敗 + 失敗的重試;Final failures ⊆ Failed runs。",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "legendFormat": "Enqueued (every run)",
          "expr": "sum(dass_tasks_created_total) or vector(0)"
        },
        {
          "refId": "B",
          "instant": true,
          "legendFormat": "Succeeded",
          "expr": "sum(dass_tasks_succeeded_total) or vector(0)"
        },
        {
          "refId": "C",
          "instant": true,
          "legendFormat": "Failed runs (incl. retries)",
          "expr": "sum(dass_tasks_failed_total) or vector(0)"
        },
        {
          "refId": "D",
          "instant": true,
          "legendFormat": "Retries (re-runs)",
          "expr": "sum(dass_tasks_retried_total) or vector(0)"
        },
        {
          "refId": "E",
          "instant": true,
          "legendFormat": "Final failures (gave up)",
          "expr": "sum(dass_tasks_final_failed_total) or vector(0)"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Tasks processed (cumulative)",
      "id": 63,
      "description": "Monotonic staircase — every enqueued/succeeded/failed task leaves a permanent step, so short tasks are always visible here even though the gauge panels above miss them.",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "dass_tasks_created_total",
          "legendFormat": "enqueued",
          "refId": "A"
        },
        {
          "expr": "dass_tasks_succeeded_total",
          "legendFormat": "succeeded",
          "refId": "B"
        },
        {
          "expr": "dass_tasks_failed_total",
          "legendFormat": "failed",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2,
            "drawStyle": "line"
          }
        }
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Scheduled dispatches (/min)",
      "id": 107,
      "description": "Scheduler enqueues per minute, from a cumulative COUNTER (dass_tasks_by_trigger_total{trigger_type='scheduled'}). Unlike the SQS 'visible' gauge — which reads ~0 because each scheduled task is consumed in <1s — this leaves one tick per dispatch.",
