{
  "uid": "dass-overview",
  "title": "DASS · Overview",
  "tags": [
    "dass"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 9,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Jobs in DB",
      "id": 1,
      "description": "jobs 表的『全部』job 定義總數 = Normal + Scheduled（見下方 Jobs (definitions) 拆分）。會跟 Normal 數字相同，只是因為目前 Scheduled = 0；一旦有排程 job，這個總數就會比 Normal 大。",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "dass_jobs_total_count",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "type": "stat",
      "title": "Scheduler DB jobs",
      "id": 99,
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(dass_scheduler_jobs_upcoming_count) or vector(0)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "description": "排程器目前手上、還沒到觸發時間的 job 數：enabled 的 scheduled job 中 next_fire_at >= now（heap 裡已武裝、等著被觸發的）。逾期未派發（next_fire_at < now）與 on-demand/normal job 都排除。"
    },
    {
      "type": "stat",
      "title": "Tasks pending",
      "id": 2,
      "description": "Messages waiting across all SQS queues (ApproximateNumberOfMessages / visible) — the real backlog of tasks enqueued but not yet picked up by a worker. Replaces the old DB status='pending' count, which never drains because task rows are never deleted, so it conflated live backlog with all-time history.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(dass_sqs_messages_visible) or vector(0)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Tasks running",
      "id": 4,
      "description": "DB snapshot: rows with status='running' — the single source of truth for 'running'. ≈ (workers × per-worker concurrency) actually claimed into the DB.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(dass_tasks_by_status_count{status=\"running\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
